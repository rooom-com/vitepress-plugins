{
  "name": "@rooom/vitepress-plugins",
  "version": "1.1.1",
  "description": "A collection of VitePress plugins: markdown-it extensions for accordion, cards, steps, Lucide icons, and more.",
  "author": "rooom AG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rooom-com/vitepress-plugins.git"
  },
  "homepage": "https://github.com/rooom-com/vitepress-plugins#readme",
  "keywords": [
    "vitepress",
    "markdown-it",
    "plugin",
    "accordion",
    "cards",
    "steps",
    "lucide",
    "docs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "peerDependencies": {
    "markdown-it": ">=13.0.0",
    "vitepress": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide": "^0.577.0",
    "markdown-it-container": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "@vitest/coverage-v8": "^4.1.3",
    "markdown-it": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
